<Page
    x:Class="GraphMobileSync.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GraphMobileSync"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Margin="24,36,24,24">
            <TextBlock Text="LiveSync" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Imports Microsoft Graph contacts and calendar events into app-owned lists that Windows 10 Mobile exposes in People and Calendar." />
            <TextBlock Text="Sync settings" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ToggleSwitch x:Name="BackgroundSyncToggleSwitch" Header="Sync in the background" OnContent="On" OffContent="Off" IsOn="True" />
            <ToggleSwitch x:Name="FailureNotificationToggleSwitch" Header="Notify me when background sync fails" OnContent="On" OffContent="Off" IsOn="False" />
            <TextBlock x:Name="BackgroundTaskStatusTextBlock" FontSize="14" />
            <TextBlock Text="Calendars to sync" />
            <TextBox x:Name="CalendarNamesTextBox" PlaceholderText="All calendars (or comma-separated calendar names)" />
            <TextBlock Text="Event window" />
            <ComboBox x:Name="EventWindowComboBox" SelectedIndex="1">
                <ComboBoxItem Tag="6">6 months</ComboBoxItem>
                <ComboBoxItem Tag="12">12 months</ComboBoxItem>
                <ComboBoxItem Tag="24">24 months</ComboBoxItem>
            </ComboBox>
            <Button x:Name="SignInButton" Content="Sign in / sign in again" Click="SignInButton_Click" HorizontalAlignment="Left" />
            <Button x:Name="SyncButton" Content="Sync contacts and calendars" Click="SyncButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <Button x:Name="BackgroundCheckButton" Content="Check Graph changes now" Click="BackgroundCheckButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <ProgressBar x:Name="SyncProgressBar" IsIndeterminate="False" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="SyncProgressTextBlock" Visibility="Collapsed" />
            <TextBlock x:Name="StatusTextBlock" Text="Sign in to begin syncing your contacts and calendars." />
            <TextBlock Text="Recent sync activity" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock x:Name="SyncHistoryTextBlock" />
            <Button Content="About LiveSync" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <ScrollViewer MaxHeight="400">
                            <StackPanel Width="280" Margin="20">
                                <TextBlock Text="About LiveSync" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="BuildVersionTextBlock" Margin="0,12,0,0" />
                                <TextBlock Margin="0,12,0,0" Text="LiveSync brings your Microsoft Graph contacts and calendars to the built-in People and Calendar apps on Windows 10 Mobile." />
                                <TextBlock Margin="0,12,0,0">
                                    <Run Text="Developed by&#160;" /><Hyperlink NavigateUri="https://github.com/ZuneTracks"><Run Text="ZuneTracks" /></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
